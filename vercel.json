{
  "version": 2,
  "functions": {
    "index.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/fonts/.*",
      "dest": "/fonts/$1"
    },
    {
      "src": "/icon.*\\.png",
      "dest": "$0"
    },
    {
      "src": "/manifest\\.webmanifest",
      "dest": "/manifest.webmanifest"
    },
    {
      "src": "/sw\\.js",
      "dest": "/sw.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}

