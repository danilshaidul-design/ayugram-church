{
  "version": 2,
  "functions": {
    "index.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/fonts/(.*)",
      "dest": "/fonts/$1",
      "headers": {
        "cache-control": "public, max-age=31536000"
      }
    },
    {
      "src": "/icon-.*\\.png",
      "dest": "$0",
      "headers": {
        "cache-control": "public, max-age=31536000"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
